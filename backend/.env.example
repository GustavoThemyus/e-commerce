# Copie para .env. O .env não vai para o git.

# Padrão: o banco que o `docker compose up -d` sobe. Funciona sem editar nada.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# Supabase, se preferir (Session pooler, porta 5432). Substitua o [YOUR-PASSWORD]
# inteiro, colchetes incluídos, e faça percent-encode de especiais (@ = %40, ! = %21).
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Opcional: sem chave o checkout funciona normalmente, só não envia o email.
# https://resend.com
RESEND_API_KEY=
