# Copie para .env. O .env não vai para o git.

# Padrão: o banco que o `docker compose up -d` sobe. Funciona sem editar nada.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# Supabase, se preferir (Session pooler, porta 5432). Substitua o [YOUR-PASSWORD]
# inteiro, colchetes incluídos, e faça percent-encode de especiais (@ = %40, ! = %21).
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Opcional: sem chave o checkout funciona normalmente, só não envia o email.
# https://resend.com
RESEND_API_KEY=

# Segredo para assinar os tokens de login (JWT). Obrigatório: o servidor não sobe sem ele.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Só para deploy (todas opcionais no desenvolvimento local) ---

# Porta do servidor. Hospedagens como a Render definem sozinhas. Padrão: 3333.
PORT=

# Origem(ns) do frontend liberadas no CORS, separadas por vírgula, sem barra no fim.
# Padrão: http://localhost:3000. Em produção: a URL do frontend (ex.: https://seu-app.vercel.app).
CORS_ORIGIN=

# Quantos proxies existem na frente do backend. Na Render use 1. Sem isso o limite de
# tentativas de login enxerga o IP do proxy e todos os visitantes dividem o mesmo limite.
TRUST_PROXY=
