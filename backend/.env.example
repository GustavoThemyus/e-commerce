# Copie para .env e preencha. O .env não vai para o git.

# Supabase: Project Settings > Database > Session pooler (porta 5432).
# Substitua o [YOUR-PASSWORD] inteiro, colchetes incluídos, e faça
# percent-encode de caracteres especiais na senha (@ = %40, ! = %21).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Postgres local, se preferir:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# https://resend.com
RESEND_API_KEY=re_sua_chave_aqui
